# Zaplie Custom Action API - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# LNbits Configuration (Required)
# ============================================
# Your LNbits instance URL
LNBITS_NODE_URL=https://your-lnbits-instance.com

# LNbits authentication credentials
LNBITS_USERNAME=your-username
LNBITS_PASSWORD=your-password

# Admin API key for the host/system wallet
LNBITS_ADMINKEY=your-admin-key

# Initial allowance for new user wallets (in sats)
LNBITS_INITIAL_ALLOWANCE=10000

# Custom label for rewards/points
LNBITS_POINTS_LABEL=Sats

# Host user/wallet for funding rewards
LNBITS_HOST_USER_ID=your-host-user-id
LNBITS_HOST_WALLET_ID=your-host-wallet-id

# ============================================
# Nostr Wallet Connect (Optional)
# ============================================
# NWC connection string for Nostr wallet integration
# Format: nostr+walletconnect://<pubkey>?relay=<relay_url>&secret=<secret>
# NWC_CONNECTION_STRING=nostr+walletconnect://...

# ============================================
# API Configuration
# ============================================
# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# Enable debug logging
DEBUG=false
